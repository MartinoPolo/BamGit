{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"src/lib/components/ui/*/index.ts",
		"src/lib/components/Resizer.svelte",
		"src/lib/modules/*/index.ts",
		"**/*.stories.svelte",
		"src/lib/reactivity/*.svelte.ts"
	],
	"ignorePatterns": ["src/lib/types/generated/**", "claude_design/**"],
	"ignoreDependencies": [
		"@typescript-eslint/parser",
		"vitest-browser-svelte",
		"@tauri-apps/plugin-opener",
		"bits-ui",
		"postcss-html",
		"@fallow-cli/win32-x64-msvc",
		"low-poly-2d-trees"
	],
	"health": {
		"maxCrap": 60
	},
	"rules": {
		"unused-files": "error",
		"unused-exports": "warn",
		"unused-types": "warn",
		"unused-dependencies": "error",
		"unused-class-members": "warn",
		"unresolved-imports": "error",
		"duplicate-exports": "off",
		"circular-dependencies": "error",
		"boundary-violations": "off",
		"stale-suppressions": "error"
	}
}
