{
	"name": "grovekeeper",
	"version": "0.1.0",
	"description": "Desktop agent orchestration GUI for parallel Claude Code sessions",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie --strategy baseLocale",
		"typecheck": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:fast": "prettier --write --log-level warn . && oxlint",
		"check:fallow": "fallow dead-code --fail-on-regression --regression-baseline fallow-baselines/dead-code-regression.json --explain",
		"check:all": "pnpm paraglide:compile && svelte-kit sync && pnpm check:fast && stylelint \"src/**/*.{css,svelte}\" && pnpm check:fallow && svelte-check --tsconfig ./tsconfig.json && eslint .",
		"fallow:audit": "fallow audit --format json --quiet --explain",
		"fallow:save-baseline": "fallow dead-code --save-regression-baseline fallow-baselines/dead-code-regression.json",
		"lint": "oxlint",
		"lint:eslint": "eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test": "vitest",
		"test:e2e": "playwright test",
		"postinstall": "node scripts/fix-worktree-links.js",
		"prepare": "husky",
		"db:reset": "node scripts/reset-database.js",
		"tailwind-canonical": "node scripts/canonical-classes.js",
		"tailwind-canonical:fix": "node scripts/canonical-classes.js --fix",
		"tauri": "tauri",
		"storybook": "svelte-kit sync && storybook dev -p 6006",
		"build:storybook": "svelte-kit sync && storybook build",
		"ports": "powershell -NoProfile -Command \"netstat -ano | Select-String ':1420 |:6006 ' | Select-String 'LISTENING'\"",
		"ports:kill": "powershell -NoProfile -Command \"$pids = @(); netstat -ano | Select-String ':1420 |:6006 ' | Select-String 'LISTENING' | ForEach-Object { if ($_ -match '\\s(\\d+)$') { $pids += $Matches[1] } }; $pids = $pids | Select-Object -Unique; if ($pids.Count -eq 0) { Write-Host 'No processes on ports 1420/6006' } else { $pids | ForEach-Object { Stop-Process -Id $_ -Force; Write-Host \\\"Killed PID $_\\\" } }\""
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@fontsource/geist": "^5.2.8",
		"@fontsource/geist-mono": "^5.2.7",
		"@inlang/paraglide-js": "^2.18.0",
		"@internationalized/date": "^3.12.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"bits-ui": "^2.16.5",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"isomorphic-dompurify": "^3.12.0",
		"layerchart": "2.0.0-next.63",
		"low-poly-2d-trees": "link:..\\low-poly-2d-trees",
		"marked": "^18.0.3",
		"paneforge": "^1.0.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	},
	"optionalDependencies": {
		"@fallow-cli/win32-x64-msvc": "^2.48.4"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.58.2",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/svelte": "^10.3.3",
		"@storybook/sveltekit": "^10.3.3",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/cli": "^2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/dagre": "^0.7.54",
		"@types/node": "^25.5.0",
		"@typescript-eslint/parser": "^8.57.2",
		"@vitest/browser-playwright": "^4.1.2",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "^10.1.0",
		"eslint-plugin-check-file": "^3.3.1",
		"eslint-plugin-storybook": "^10.3.3",
		"eslint-plugin-svelte": "^3.16.0",
		"fallow": "^2.48.4",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxlint": "^1.58.0",
		"playwright": "^1.58.2",
		"postcss-html": "^1.8.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"storybook": "^10.3.3",
		"stylelint": "^17.6.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"svelte-eslint-parser": "^1.6.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^2.1.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
	"pnpm": {}
}
